# Copie para .env e gere valores novos. Nunca commite o .env.
#
# openssl rand -base64 48
# openssl rand -base64 24

NODE_ENV=development
API_PORT=43148
APP_ORIGIN=http://127.0.0.1:43147

# Em produção: Postgres no Compose. Em desenvolvimento local a API usa PGlite se isto estiver vazio.
DATABASE_URL=
POSTGRES_PASSWORD=altere-esta-password-da-base

SESSION_SECRET=substitua-por-pelo-menos-32-caracteres-aleatorios
ADMIN_EMAIL=tania@ena.pt
ADMIN_PASSWORD=altere-me-no-primeiro-arranque
ADMIN_NAME=Tania

# log = só histórico na API (sem SMTP). smtp = envio real (MAILPIT no dev: smtp://127.0.0.1:1025)
MAIL_MODE=log
SMTP_URL=
MAIL_FROM=ENA Formação <formacao@ena.pt>

# URL pública da app (pré-inscrição e CTAs de email). Sem área de formando.
# APP_ORIGIN=https://o-seu-dominio.vercel.app

# Google Drive da entidade (OAuth 2.0). Sem isto os uploads ficam no servidor.
# 1. Google Cloud Console → activar Google Drive API
# 2. Ecrã de consentimento OAuth (interno, se for Google Workspace da ENA)
# 3. Cliente OAuth «Aplicação Web»
# 4. URI de redireccionamento: {APP_ORIGIN}/api/v1/drive/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://127.0.0.1:43147/api/v1/drive/oauth/callback
GOOGLE_DRIVE_FOLDER=GesForma
# Pasta partilhada já existente (Shared Drive ou pasta da secretaria):
# GOOGLE_DRIVE_FOLDER_ID=
# drive.file = só ficheiros criados pelo GesForma; drive = Drive completo da conta
GOOGLE_DRIVE_SCOPE=drive.file
