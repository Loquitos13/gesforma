# GesForma na VPS (Hetzner): o Caddy faz o HTTPS (certificado Let's Encrypt automático), serve o site já construído
# (dist/) e passa à API o que a Vercel passava à função: /api/*, as páginas do site (com as etiquetas de SEO),
# /sitemap.xml e /robots.txt. É o equivalente ao vercel.json.
#
# O domínio vem do .env (DOMINIO=ena.pt). O DNS do domínio tem de apontar para o IP da VPS antes de arrancar.

{
	email {$EMAIL_CERTIFICADOS}
}

# Páginas, sitemap e robots vêm da API, que também manda cabeçalhos de segurança (Helmet). Aqui ficam só os do Caddy:
# sem isto saíam em duplicado e contraditórios (duas CSP, dois HSTS, dois Referrer-Policy).
(cabecalhos_so_do_caddy) {
	header_down -Content-Security-Policy
	header_down -Strict-Transport-Security
	header_down -Referrer-Policy
	header_down -X-Content-Type-Options
	header_down -X-Frame-Options
	header_down -Permissions-Policy
}

{$DOMINIO} {
	encode zstd gzip

	# Cabeçalhos de segurança do site (os mesmos do vercel.json); a API manda os seus.
	@site not path /api/*
	header @site {
		Content-Security-Policy "default-src 'self'; script-src 'self' https://www.googletagmanager.com https://www.google-analytics.com https://*.google-analytics.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://www.google.com https://connect.facebook.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com https://*.g.doubleclick.net https://www.google.com https://www.google.pt https://pagead2.googlesyndication.com https://www.googleadservices.com https://www.facebook.com https://connect.facebook.net; frame-src 'self' blob: https://www.googletagmanager.com https://td.doubleclick.net https://www.facebook.com https://drive.google.com https://docs.google.com https://www.youtube-nocookie.com https://player.vimeo.com https://maps.google.com https://www.google.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self' https://accounts.google.com https://login.microsoftonline.com"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000"
	}
	# Sem assinaturas da tecnologia (Server, Via), também nas respostas que vêm da API.
	header {
		-Server
		-Via
		defer
	}

	# Ficheiros e pastas ocultos (.env, .git, .htaccess…): 404 sempre, nunca chegam ao site nem à API.
	# O /.well-known fica de fora (certificados e verificações de domínio).
	@ocultos {
		path_regexp ocultos /\.
		not path /.well-known/*
	}
	handle @ocultos {
		respond 404
	}
	# Cópias de segurança e ficheiros de configuração esquecidos.
	@sensiveis path *.bak *.sql *.sql.gz *.zip *.tar *.tar.gz *.env *.log *.yml *.yaml *.ini *.conf
	handle @sensiveis {
		respond 404
	}

	# API: /api/v1/... chega à API como /v1/... (como na Vercel e no vite.config.ts).
	handle_path /api/* {
		reverse_proxy api:43148
	}

	handle /sitemap.xml {
		rewrite * /v1/public/sitemap.xml
		reverse_proxy api:43148 {
			import cabecalhos_so_do_caddy
		}
	}
	handle /robots.txt {
		rewrite * /v1/public/robots.txt
		reverse_proxy api:43148 {
			import cabecalhos_so_do_caddy
		}
	}

	# Ficheiros do build (JS, CSS, imagens, ícones). Os de /assets têm o hash no nome: cache de um ano.
	@ficheiro {
		not path /
		file {
			root /srv/dist
			try_files {path}
		}
	}
	handle @ficheiro {
		root * /srv/dist
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Tudo o resto é uma página do site ou do backoffice: a API devolve a aplicação com o título, a descrição
	# e os dados de partilha da página (server/src/seo.ts).
	handle {
		rewrite * /v1/public/pagina?caminho={path}
		reverse_proxy api:43148 {
			import cabecalhos_so_do_caddy
		}
	}

	log {
		output stdout
		format console
	}
}

# Com o domínio principal (ena.pt), o www passa para ele (301: a Google fica só com um endereço de cada página).
# O www tem de apontar para a VPS (CNAME para ena.pt); senão, comente estas 3 linhas.
www.{$DOMINIO} {
	header -Server
	redir https://{$DOMINIO}{uri} permanent
}
